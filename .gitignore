# =========================================
# 🧩 PYTHON & STREAMLIT PROJECT GITIGNORE
# =========================================

# --- Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments ---
.env
.venv/
venv/
env/
ENV/
.conda/
conda/
pip-wheel-metadata/

# --- Environment variables ---
*.env
.env.*
!example.env  # Keep a sample env file

# --- Jupyter & notebooks ---
.ipynb_checkpoints
*.ipynb_convert
*.nbconvert.ipynb

# --- Build / Packaging ---
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# --- PyInstaller ---
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos.
*.manifest
*.spec

# --- Unit test / coverage reports ---
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
*.pytest_cache/
htmlcov/
test-results/
junit/

# --- Logs & Debug ---
*.log
*.out
*.err
logs/
logging/
debug.log
profile.json

# --- Streamlit specific ---
.streamlit/secrets.toml
.streamlit/config.toml
# Ignore autogenerated streamlit cache
.streamlit/cache/
.streamlit/static/

# --- FastAPI / Uvicorn ---
uvicorn.log
*.db-journal
*.sqlite3
*.sqlite
instance/
*.pid

# --- Data & temporary files ---
data/
Data/
datasets/
*.csv
*.tsv
*.parquet
*.jsonl
*.bak
*.zip
*.tar.gz
*.tmp
temp/
tmp/
.cache/
.DS_Store

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.code-workspace

# --- OS Files ---
Thumbs.db
.DS_Store
ehthumbs.db
Icon?
Desktop.ini

# --- Model / AI Artifacts ---
checkpoints/
models/
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.pkl
*.joblib
*.bin
*.model

# --- Docker / Compose ---
*.pid
*.seed
docker-compose.override.yml
.dockerignore
.Dockerfile.swp

# --- LLM / API Integrations ---
openai_api_key.txt
keys/
tokens/
credentials.json
creds.json
config.yaml
config.yml

# --- Node / Frontend (if used with Streamlit Components) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- PyCharm & JetBrains ---
.idea/
*.iml
out/

# --- MyPy / Type Checking ---
.mypy_cache/
.dmypy.json
dmypy.json

# --- Ruff / Lint / Formatters ---
.ruff_cache/
*.pyre/
.pytype/

# --- Others ---
*.bak
*.orig
*.rej
*~
# backup files
*#

# --- Custom Project Specific ---
# Exclude internal data files or test datasets
/work/Projects/*
!/work/Projects/README.md